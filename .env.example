# Copy this file to .env in this same directory (the repository root) and
# fill in a real key. Never commit the real .env -- it is gitignored.
#
# backend/config.py loads this file from two places: the parent of the repo
# root, and the repo root itself (which wins if both exist). For a fresh
# clone, putting .env right here -- next to this .env.example -- is the path
# that is guaranteed to work.

# Required. All five agents authenticate through Portkey with this key.
PORTKEY_API_KEY=

# Optional overrides -- defaults match mcp_server's --port 8787 and are fine
# for a single local checkout.
# CAMPUS_MCP_HOST=127.0.0.1
# CAMPUS_MCP_PORT=8787
# CAMPUS_MCP_URL=http://127.0.0.1:8787/mcp
